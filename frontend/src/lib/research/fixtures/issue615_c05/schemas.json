            "source_scope"
          ]
        },
        "then": {
          "properties": {
            "source_scope": {
              "properties": {
                "single_source_id": {
                  "type": "string",
                  "minLength": 1
                },
                "source_ids": {
                  "maxItems": 0
                }
              }
            }
          }
        }
      }
    ]
  },
  "c05_preview_response": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
