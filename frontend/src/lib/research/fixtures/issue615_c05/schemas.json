        "type": "object",
        "required": [
          "mode",
          "contract_version",
          "resolved_source_refs",
          "note_ids",
          "single_source_id",
          "missing_source_ids",
          "includes_exact_versions",
          "contains_document_body",
          "warnings"
        ],
        "properties": {
          "mode": {
            "type": "string",
            "enum": [
              "all",
              "selected",
              "single"
            ]
          },
