{
  "c05_scope_request": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "C-05 scope request (contract c05-v1)",
    "description": "#615 §3.2：source_scope 是请求体的受控子集；成员只能是字符串（数字、布尔、null、对象一律拒绝，不转 ID）。note_ids 与 source_scope 同级，且**顶层容器**与 scope 子集采用一致规则：缺失／null 归一为 []。",
    "type": "object",
    "required": [
      "source_scope"
    ],
    "properties": {
      "source_scope": {
        "type": "object",
        "required": [
          "mode"
        ],
        "properties": {
          "mode": {
            "type": "string",
            "enum": [
              "all",
              "selected",
              "single"
            ]
          },
          "source_ids": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": "string"
            },
            "description": "缺失／null 归一为 []；成员只能是字符串。"
          },
          "single_source_id": {
            "type": [
              "string",
              "null"
            ],
            "description": "只能是字符串／null；非字符串拒绝。"
          }
        },
        "additionalProperties": false
      },
      "note_ids": {
        "type": [
          "array",
          "null"
        ],
        "items": {
          "type": "string"
        }
      }
    },
    "additionalProperties": true,
    "allOf": [
      {
        "if": {
          "properties": {
            "source_scope": {
              "properties": {
                "mode": {
                  "const": "all"
                }
              },
              "required": [
                "mode"
              ]
            }
          },
          "required": [
            "source_scope"
          ]
        },
        "then": {
          "properties": {
            "source_scope": {
              "properties": {
                "source_ids": {
                  "maxItems": 0
                },
                "single_source_id": {
                  "type": "null"
                }
              }
            }
          }
        }
      },
      {
        "if": {
          "properties": {
            "source_scope": {
              "properties": {
                "mode": {
                  "const": "selected"
                }
              },
              "required": [
                "mode"
              ]
            }
          },
          "required": [
            "source_scope"
          ]
        },
        "then": {
          "properties": {
            "source_scope": {
              "properties": {
                "single_source_id": {
                  "type": "null"
                }
              }
            }
          }
        }
      },
      {
        "if": {
          "properties": {
            "source_scope": {
              "properties": {
                "mode": {
                  "const": "single"
                }
              },
              "required": [
                "mode"
              ]
            }
          },
          "required": [
            "source_scope"
          ]
        },
        "then": {
          "properties": {
            "source_scope": {
              "properties": {
                "single_source_id": {
                  "type": "string",
                  "minLength": 1
                },
                "source_ids": {
                  "maxItems": 0
                }
              }
            }
          }
        }
      }
    ]
  },
  "resolved_scope": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Resolved scope without document body (contract c05-v1)",
    "description": "#615 §3.3：范围快照不含正文；精确引用键为 {document_id, document_version}。fresh、202、完成重放与 SSE usage/done 采用同一 schema。",
    "type": "object",
    "required": [
      "mode",
      "contract_version",
      "resolved_source_refs",
      "note_ids",
      "single_source_id",
      "missing_source_ids",
      "includes_exact_versions",
      "contains_document_body",
      "warnings"
    ],
    "properties": {
      "mode": {
        "type": "string",
        "enum": [
          "all",
          "selected",
          "single"
        ]
      },
      "contract_version": {
        "type": "string",
        "const": "c05-v1"
      },
      "resolved_source_refs": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "document_id",
            "document_version"
          ],
          "properties": {
            "document_id": {
              "type": "string",
              "minLength": 1
            },
            "document_version": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        }
      },
      "note_ids": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "single_source_id": {
        "type": [
          "string",
          "null"
        ]
      },
      "missing_source_ids": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "includes_exact_versions": {
        "type": "boolean",
        "const": true
      },
      "contains_document_body": {
        "type": "boolean",
        "const": false
      },
      "warnings": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "code",
            "message",
            "documents"
          ],
          "properties": {
            "code": {
              "type": "string",
              "minLength": 1
            },
            "message": {
              "type": "string"
            },
            "documents": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "document_id",
                  "used_version",
                  "skipped_version"
                ],
                "properties": {
                  "document_id": {
                    "type": "string"
                  },
                  "used_version": {
                    "type": "string",
                    "description": "无可读版本而被排除时为空字符串。"
                  },
                  "skipped_version": {
                    "type": "string"
                  }
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        }
      }
    },
    "additionalProperties": false
  },
  "c05_scope_response_projection": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Additive scope fields on generation responses (contract c05-v1)",
    "description": "#615 §3.3：C-05 响应加性携带范围快照；快照缺失时两个键都不出现（旧历史不补造范围）。",
    "type": "object",
    "required": [
      "scope_contract_version",
      "resolved_scope"
    ],
    "properties": {
      "scope_contract_version": {
        "type": "string",
        "const": "c05-v1"
      },
      "resolved_scope": {
        "$ref": "#/definitions/resolved_scope"
      }
    },
    "definitions": {
      "resolved_scope": {
        "type": "object",
        "required": [
          "mode",
          "contract_version",
          "resolved_source_refs",
          "note_ids",
          "single_source_id",
          "missing_source_ids",
          "includes_exact_versions",
          "contains_document_body",
          "warnings"
        ],
        "properties": {
          "mode": {
            "type": "string",
            "enum": [
              "all",
              "selected",
              "single"
            ]
          },
          "contract_version": {
            "type": "string",
            "const": "c05-v1"
          },
          "resolved_source_refs": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "document_id",
                "document_version"
              ],
              "properties": {
                "document_id": {
                  "type": "string",
                  "minLength": 1
                },
                "document_version": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "additionalProperties": false
            }
          },
          "note_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "single_source_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "missing_source_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "includes_exact_versions": {
            "type": "boolean",
            "const": true
          },
          "contains_document_body": {
            "type": "boolean",
            "const": false
          },
          "warnings": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "code",
                "message",
                "documents"
              ],
              "properties": {
                "code": {
                  "type": "string",
                  "minLength": 1
                },
                "message": {
                  "type": "string"
                },
                "documents": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "document_id",
                      "used_version",
                      "skipped_version"
                    ],
                    "properties": {
                      "document_id": {
                        "type": "string"
                      },
                      "used_version": {
                        "type": "string",
                        "description": "无可读版本而被排除时为空字符串。"
                      },
                      "skipped_version": {
                        "type": "string"
                      }
                    },
                    "additionalProperties": false
                  }
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "additionalProperties": false
  },
  "c05_entry_capability": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Per-entry C-05 capability (contract c05-v1)",
    "description": "#615 §3.3：契约支持与执行就绪分别表达。execution_ready=false 时 execution_modes/context_levels 为空数组——不得据 scope_modes 推断可执行。",
    "type": "object",
    "required": [
      "scope_modes",
      "execution_modes",
      "context_levels",
      "preview_supported",
      "execution_ready",
      "unavailable_reason"
    ],
    "properties": {
      "scope_modes": {
        "type": "array",
        "items": {
          "type": "string",
          "enum": [
            "all",
            "selected",
            "single"
          ]
        },
        "uniqueItems": true
      },
      "execution_modes": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "context_levels": {
        "type": "array",
        "items": {
          "type": "string",
          "enum": [
            "focused",
            "document",
            "workspace"
          ]
        }
      },
      "preview_supported": {
        "type": "boolean"
      },
      "execution_ready": {
        "type": "boolean"
      },
      "unavailable_reason": {
        "type": [
          "string",
          "null"
        ]
      }
    },
    "additionalProperties": false,
    "allOf": [
      {
        "if": {
          "properties": {
            "execution_ready": {
              "const": false
            }
          },
          "required": [
            "execution_ready"
          ]
        },
        "then": {
          "properties": {
            "preview_supported": {
              "const": false
            }
          }
        }
      }
    ]
  },
  "c05_capabilities": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "C-05 capability block (contract c05-v1)",
