        "const": "c05-v1"
      },
      "enabled": {
        "type": "boolean"
      },
      "preview_supported": {
        "type": "boolean"
      },
      "entries": {
        "type": "object",
        "required": [
          "search",
          "chat",
          "coverage",
          "compare",
          "ai_insight",
          "transformation"
        ],
        "additionalProperties": false,
        "properties": {
          "search": {
            "$ref": "#/definitions/entry"
          },
          "chat": {
            "$ref": "#/definitions/entry"
          },
          "coverage": {
            "$ref": "#/definitions/entry"
          },
          "compare": {
            "$ref": "#/definitions/entry"
          },
          "ai_insight": {
            "$ref": "#/definitions/entry"
          },
          "transformation": {
            "$ref": "#/definitions/entry"
          }
        }
      }
    },
    "definitions": {
      "entry": {
        "type": "object",
        "required": [
          "scope_modes",
          "execution_modes",
          "context_levels",
          "preview_supported",
          "execution_ready",
          "unavailable_reason"
        ],
        "properties": {
          "scope_modes": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "all",
                "selected",
                "single"
              ]
            },
            "uniqueItems": true
          },
          "execution_modes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "context_levels": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "focused",
                "document",
                "workspace"
              ]
            }
          },
          "preview_supported": {
            "type": "boolean"
          },
          "execution_ready": {
            "type": "boolean"
          },
          "unavailable_reason": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "execution_ready": {
                  "const": false
                }
              },
              "required": [
                "execution_ready"
              ]
            },
            "then": {
              "properties": {
                "preview_supported": {
                  "const": false
                }
              }
            }
          }
        ]
      }
    },
    "additionalProperties": false
  },
  "c05_error_detail": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "C-05 error detail with client action (contract c05-v1)",
    "description": "#615 §5：错误支持对象 detail、历史字符串 detail 和框架数组 detail。客户端据 acceptance/action 决定下一步，不解析英文文案。HTTP 422/503 本身不能证明零接受。",
    "type": "object",
    "required": [
      "code"
    ],
    "properties": {
      "code": {
        "type": "string",
        "minLength": 1
      },
      "message": {
        "type": "string"
      },
      "entry": {
        "type": "string",
        "enum": [
          "search",
          "chat",
          "coverage",
          "compare",
          "ai_insight",
          "transformation",
          "preview"
        ]
      },
      "generation_id": {
        "type": [
          "string",
          "null"
        ]
      },
      "state": {
        "type": [
          "string",
          "null"
        ]
      },
      "retryable": {
        "type": "boolean"
      },
      "retry_with_original_idempotency_key": {
        "type": "boolean"
      },
      "recovery_action": {
        "type": "string",
        "enum": [
          "show_validation",
          "reselect_sources",
          "retry_same_key",
          "reconcile_then_retry",
          "read_original_result",
          "show_conflict",
          "show_unavailable",
          "stop_and_confirm"
        ],
        "description": "#615 §5（D-04）：机器可读的客户端动作。前端不必解析英文 message；`retry_with_original_idempotency_key` 只表示**原键查证**，不授权重新执行。"
      },
      "acceptance": {
        "type": "string",
        "enum": [
          "not_accepted",
          "accepted",
          "unknown"
        ],
        "description": "接受知识。HTTP 422/503 本身**不能**证明零接受——未分类错误收敛为 unknown。"
      },
      "action_recognised": {
        "type": "boolean",
        "description": "仅当组合未在 C-05 契约内分类时出现（false）——调用方按既有层语义处理，不得据此自动重试。"
      }
    },
    "additionalProperties": true
  },
  "c05_entry_capability_pr615": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Per-entry C-05 capability (contract c05-v1)",
